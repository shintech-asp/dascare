# Where the app reaches the DASCARE PHP API (XAMPP on your Mac).
# Rebuild after changing this: npm run sync
#
# Android emulator — 10.0.2.2 is the emulator's alias for your Mac:
VITE_API_BASE_URL=http://10.0.2.2/Dascare/dascare_api
#
# Real phone on the same Wi-Fi — use your Mac's Wi-Fi IP
# (find it with: ipconfig getifaddr en0). It changes per network.
# VITE_API_BASE_URL=http://192.168.1.5/Dascare/dascare_api
