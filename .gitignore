# Dependencies / build output
node_modules/
dist/

# Uploaded personal data (KYC IDs, emergency photos, org documents) — never commit
uploads/
dascare_api/storage/organization-documents/*
!dascare_api/storage/organization-documents/.htaccess

# Android build output (dascare_mobile/android)
.gradle/
build/
local.properties
*.apk
*.aab
.idea/
captures/

# OS / editor
.DS_Store
*.log


# Mobile app API address is per-machine/network (see dascare_mobile/.env.example)
dascare_mobile/.env
# Generated by dascare_mobile/scripts/build-icon-subset.mjs on every dev/build
dascare_mobile/src/assets/icon-subset.json


# Built APKs (npm run apk)
dascare_mobile/release/

# Secrets: Firebase service account (push) and the app's Firebase config — never commit
dascare_api/config/*.json
dascare_mobile/android/app/google-services.json

# Published app for the landing page download button (npm run apk:web)
dascare/public/downloads/
